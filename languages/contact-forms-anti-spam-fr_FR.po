msgid "Leave this field empty"
msgstr "Laissez ce champ vide"

msgid "Comment blocked"
msgstr "Commentaire bloqué"

msgid "This submission was blocked as spam."
msgstr "Cet envoi a été bloqué en tant que spam."




msgid "No thanks"
msgstr "Non merci"

msgid "Your InputGate is currently using IP-only protection"
msgstr "Votre InputGate utilise une protection par IP uniquement"

msgid "Your InputGate is checking the sender’s IP only. Full Protection goes further, analyzing submitted content, user behavior, and multiple additional spam signals to catch significantly more spam."
msgstr "Votre InputGate vérifie uniquement l’adresse IP de l’expéditeur. La Protection complète va plus loin et analyse le contenu envoyé, le comportement de l’utilisateur et de nombreux autres signaux de spam pour bloquer nettement plus de spam."

msgid "Enable Full Protection"
msgstr "Activer la Protection complète"

msgid "See settings"
msgstr "Voir les réglages"

msgid "Maspik – Spam protection"
msgstr "Maspik – Protection anti-spam"

msgid "blocked in the last 30 days"
msgstr "bloqués ces 30 derniers jours"

msgid "blocked in total"
msgstr "bloqués au total"

msgid "%s today"
msgstr "%s aujourd’hui"

msgid "Caught most by"
msgstr "Détectés surtout par"

msgid "Most targeted form"
msgstr "Formulaire le plus visé"

msgid "Last blocked"
msgstr "Dernier blocage"

msgid "%s ago"
msgstr "il y a %s"

msgid "Nothing blocked in the last 30 days. Your forms are quiet."
msgstr "Rien de bloqué ces 30 derniers jours. Vos formulaires sont au calme."

msgid "No protection layer is switched on yet."
msgstr "Aucune couche de protection n’est encore activée."

msgid "Logging is off, so there is nothing to break down here. Blocking itself is unaffected."
msgstr "La journalisation est désactivée, il n’y a donc rien à détailler ici. Le blocage n’est pas affecté."

msgid "Turn on logging"
msgstr "Activer la journalisation"

msgid "Open the log"
msgstr "Ouvrir le journal"

msgid "Set up protection"
msgstr "Configurer la protection"

msgid "View log"
msgstr "Voir le journal"

msgid "Blocked submissions per day over the last 30 days"
msgstr "Envois bloqués par jour sur les 30 derniers jours"

msgid "Unknown"
msgstr "Inconnu"

msgid "Honeypot"
msgstr "Honeypot"

msgid "Verification Key"
msgstr "Clé de vérification"

