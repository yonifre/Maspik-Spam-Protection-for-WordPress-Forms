msgstr "Règles d’URL"

msgid "Country rules"
msgstr "Règles de pays"

msgid "IP blocklist"
msgstr "Liste de blocage IP"

msgid "IP reputation"
msgstr "Réputation IP"

msgid "Phone format"
msgstr "Format de téléphone"

msgid "Link limit"
msgstr "Limite de liens"

msgid "Language required"
msgstr "Langue requise"

msgid "Language forbidden"
msgstr "Langue interdite"

msgid "Length limit"
msgstr "Limite de longueur"

